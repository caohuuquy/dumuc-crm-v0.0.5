    match /laborers/{docId} {
      allow get: if isSignedIn() && isValidId(docId);
      allow list: if isSignedIn();
      allow create, update: if isSignedIn() && isValidId(docId) && isValidPayload(incoming());
      allow delete: if isSignedIn() && isValidId(docId);
    }

    match /departments/{docId} {
      allow get: if isSignedIn() && isValidId(docId);
      allow list: if isSignedIn();
      allow create, update: if isSignedIn() && isValidId(docId) && isValidPayload(incoming());
      allow delete: if isSignedIn() && isValidId(docId);
    }

    match /positions/{docId} {
      allow get: if isSignedIn() && isValidId(docId);
      allow list: if isSignedIn();
      allow create, update: if isSignedIn() && isValidId(docId) && isValidPayload(incoming());
      allow delete: if isSignedIn() && isValidId(docId);
    }

    match /salary_grades/{docId} {
      allow get: if isSignedIn() && isValidId(docId);
      allow list: if isSignedIn();
      allow create, update: if isSignedIn() && isValidId(docId) && isValidPayload(incoming());
      allow delete: if isSignedIn() && isValidId(docId);
    }

    match /contract_types/{docId} {
      allow get: if isSignedIn() && isValidId(docId);
      allow list: if isSignedIn();
      allow create, update: if isSignedIn() && isValidId(docId) && isValidPayload(incoming());
      allow delete: if isSignedIn() && isValidId(docId);
    }

    match /salary_rule_groups/{docId} {
      allow get: if isSignedIn() && isValidId(docId);
      allow list: if isSignedIn();
      allow create, update: if isSignedIn() && isValidId(docId) && isValidPayload(incoming());
      allow delete: if isSignedIn() && isValidId(docId);
    }

    match /salary_structures/{docId} {
      allow get: if isSignedIn() && isValidId(docId);
      allow list: if isSignedIn();
      allow create, update: if isSignedIn() && isValidId(docId) && isValidPayload(incoming());
      allow delete: if isSignedIn() && isValidId(docId);
    }

    match /social_insurance_versions/{docId} {
      allow get: if isSignedIn() && isValidId(docId);
      allow list: if isSignedIn();
      allow create, update: if isSignedIn() && isValidId(docId) && isValidPayload(incoming());
      allow delete: if isSignedIn() && isValidId(docId);
    }

    match /pit_versions/{docId} {
      allow get: if isSignedIn() && isValidId(docId);
      allow list: if isSignedIn();
      allow create, update: if isSignedIn() && isValidId(docId) && isValidPayload(incoming());
      allow delete: if isSignedIn() && isValidId(docId);
    }

    match /family_deduction_versions/{docId} {
      allow get: if isSignedIn() && isValidId(docId);
      allow list: if isSignedIn();
      allow create, update: if isSignedIn() && isValidId(docId) && isValidPayload(incoming());
      allow delete: if isSignedIn() && isValidId(docId);
    }

    match /payroll_periods/{docId} {
      allow get: if isSignedIn() && isValidId(docId);
      allow list: if isSignedIn();
      allow create, update: if isSignedIn() && isValidId(docId) && isValidPayload(incoming());
      allow delete: if isSignedIn() && isValidId(docId);
    }

    match /payroll_tables/{docId} {
      allow get: if isSignedIn() && isValidId(docId);
      allow list: if isSignedIn();
      allow create, update: if isSignedIn() && isValidId(docId) && isValidPayload(incoming());
      allow delete: if isSignedIn() && isValidId(docId);
    }

    match /spare_parts_items/{docId} {
      allow get: if isSignedIn() && isValidId(docId);
      allow list: if isSignedIn();
      allow create, update: if isSignedIn() && isValidId(docId) && isValidPayload(incoming());
      allow delete: if isSignedIn() && isValidId(docId);
    }

    match /vehicles_items/{docId} {
      allow get: if isSignedIn() && isValidId(docId);
      allow list: if isSignedIn();
      allow create, update: if isSignedIn() && isValidId(docId) && isValidPayload(incoming());
      allow delete: if isSignedIn() && isValidId(docId);
    }

    match /tax_categories_items/{docId} {
      allow get: if isSignedIn() && isValidId(docId);
      allow list: if isSignedIn();
      allow create, update: if isSignedIn() && isValidId(docId) && isValidPayload(incoming());
      allow delete: if isSignedIn() && isValidId(docId);
    }

    match /category_units_items/{docId} {
      allow get: if isSignedIn() && isValidId(docId);
      allow list: if isSignedIn();
      allow create: if isSignedIn() && isValidId(docId) && isValidCategoryUnit(incoming());
      allow update: if isSignedIn() && isValidId(docId) && isValidCategoryUnit(incoming())
        && incoming().id == resource.data.id
        && incoming().diff(resource.data).affectedKeys().hasOnly(['name', '_order']);
      allow delete: if isSignedIn() && isValidId(docId);
    }

    match /category_bank_accounts_items/{docId} {
      allow get: if isSignedIn() && isValidId(docId);
      allow list: if isSignedIn();
      allow create: if isSignedIn() && isValidId(docId) && isValidCategoryBankAccount(incoming());
      allow update: if isSignedIn() && isValidId(docId) && isValidCategoryBankAccount(incoming())
        && incoming().id == resource.data.id
        && incoming().diff(resource.data).affectedKeys().hasOnly(['bankCode', 'bankName', 'accountNumber', 'accountHolder', 'isReceiptAccount', 'isPaymentAccount', 'isDefault', '_order']);
      allow delete: if isSignedIn() && isValidId(docId);
    }

    match /document_storage_categories_items/{docId} {
      allow get: if isSignedIn() && isValidId(docId);
      allow list: if isSignedIn();
      allow create: if isSignedIn() && isValidId(docId) && isValidDocumentStorageCategory(incoming());
      allow update: if isSignedIn() && isValidId(docId) && isValidDocumentStorageCategory(incoming())
        && incoming().id == resource.data.id
        && incoming().diff(resource.data).affectedKeys().hasOnly(['groupName', 'note', 'documentTypes', '_order']);
      allow delete: if isSignedIn() && isValidId(docId);
    }

    match /document_cabinet_items/{docId} {
      allow get: if isSignedIn() && isValidId(docId);
      allow list: if isSignedIn();
      allow create: if isSignedIn() && isValidId(docId) && isValidDocumentCabinet(incoming());
      allow update: if isSignedIn() && isValidId(docId) && isValidDocumentCabinet(incoming())
        && incoming().id == resource.data.id
        && incoming().diff(resource.data).affectedKeys().hasOnly(['documentGroup', 'documentType', 'storageType', 'location', 'effectiveDate', 'expiryDate', 'isValid', 'files', 'updatedAt', '_order']);
      allow delete: if isSignedIn() && isValidId(docId);
