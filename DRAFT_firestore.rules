rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Default-Deny Catch-All for unmapped paths
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null && request.auth.uid is string && request.auth.uid.size() >= 1;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function isValidPayload(data) {
      return data is map && data.keys().size() >= 1 && data.keys().size() <= 200;
    }

    function isValidCategoryUnit(data) {
      return data is map
        && data.keys().hasAll(['id', 'name'])
        && data.keys().hasOnly(['id', 'name', '_order'])
        && data.id is string && data.id.size() >= 1 && data.id.size() <= 128
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 200
        && (!('_order' in data) || data._order is number);
    }

    function isValidCategoryBankAccount(data) {
      return data is map
        && data.keys().hasAll(['id', 'bankCode', 'bankName', 'accountNumber', 'accountHolder', 'isReceiptAccount', 'isPaymentAccount', 'isDefault'])
        && data.keys().hasOnly(['id', 'bankCode', 'bankName', 'accountNumber', 'accountHolder', 'isReceiptAccount', 'isPaymentAccount', 'isDefault', '_order'])
        && data.id is string && data.id.size() >= 1 && data.id.size() <= 128
        && data.bankCode is string && data.bankCode.size() >= 1 && data.bankCode.size() <= 50
        && data.bankName is string && data.bankName.size() <= 250
        && data.accountNumber is string && data.accountNumber.size() >= 1 && data.accountNumber.size() <= 64
        && data.accountHolder is string && data.accountHolder.size() <= 200
        && data.isReceiptAccount is bool
        && data.isPaymentAccount is bool
        && data.isDefault is bool
        && (!('_order' in data) || data._order is number);
    }

    function isValidDocumentStorageCategory(data) {
      return data is map
        && data.keys().hasAll(['id', 'groupName', 'note', 'documentTypes'])
        && data.keys().hasOnly(['id', 'groupName', 'note', 'documentTypes', '_order'])
        && data.id is string && data.id.size() >= 1 && data.id.size() <= 128 && data.id.matches('^[a-zA-Z0-9_\\-]+$')
        && data.groupName is string && data.groupName.size() >= 1 && data.groupName.size() <= 200
        && data.note is string && data.note.size() <= 1000
        && data.documentTypes is list && data.documentTypes.size() <= 100
        && (data.documentTypes.size() == 0 || (
          data.documentTypes[0] is map
          && data.documentTypes[0].keys().hasAll(['id', 'name', 'note'])
          && data.documentTypes[0].keys().hasOnly(['id', 'name', 'note'])
          && data.documentTypes[0].id is string && data.documentTypes[0].id.size() >= 1 && data.documentTypes[0].id.size() <= 128
          && data.documentTypes[0].name is string && data.documentTypes[0].name.size() >= 1 && data.documentTypes[0].name.size() <= 200
          && data.documentTypes[0].note is string && data.documentTypes[0].note.size() <= 500
        ))
        && (!('_order' in data) || data._order is number);
    }

    function isValidDocumentCabinet(data) {
      return data is map
        && data.keys().hasAll(['id', 'documentGroup', 'documentType', 'storageType', 'location', 'effectiveDate', 'expiryDate', 'isValid', 'files', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['id', 'documentGroup', 'documentType', 'storageType', 'location', 'effectiveDate', 'expiryDate', 'isValid', 'files', 'createdAt', 'updatedAt', '_order'])
        && data.id is string && data.id.size() >= 1 && data.id.size() <= 128 && data.id.matches('^[a-zA-Z0-9_\\-]+$')
        && data.documentGroup is string && data.documentGroup.size() >= 1 && data.documentGroup.size() <= 200
        && data.documentType is string && data.documentType.size() <= 200
        && data.storageType is string && data.storageType.size() <= 100
        && data.location is string && data.location.size() <= 200
        && data.effectiveDate is string && data.effectiveDate.size() <= 32
        && data.expiryDate is string && data.expiryDate.size() <= 32
        && data.isValid is bool
        && data.files is list && data.files.size() <= 50
        && (data.files.size() == 0 || (
          data.files[0] is map
          && data.files[0].keys().hasAll(['id', 'description', 'link', 'fileName'])
          && data.files[0].keys().hasOnly(['id', 'description', 'link', 'fileName'])
          && data.files[0].id is string && data.files[0].id.size() >= 1 && data.files[0].id.size() <= 128
          && data.files[0].description is string && data.files[0].description.size() <= 500
          && data.files[0].link is string && data.files[0].link.size() <= 500
          && data.files[0].fileName is string && data.files[0].fileName.size() <= 255
        ))
        && data.createdAt is string && data.createdAt.size() <= 64
        && data.updatedAt is string && data.updatedAt.size() <= 64
        && (!('_order' in data) || data._order is number);
    }

    match /test/{docId} {
      allow get: if isSignedIn() && isValidId(docId);
      allow list: if isSignedIn();
      allow create, update: if isSignedIn() && isValidId(docId) && isValidPayload(incoming());
      allow delete: if isSignedIn() && isValidId(docId);
    }

    match /potential_customers/{docId} {
      allow get: if isSignedIn() && isValidId(docId);
      allow list: if isSignedIn();
      allow create, update: if isSignedIn() && isValidId(docId) && isValidPayload(incoming());
      allow delete: if isSignedIn() && isValidId(docId);
    }

    match /proactive_reminders/{docId} {
      allow get: if isSignedIn() && isValidId(docId);
      allow list: if isSignedIn();
      allow create, update: if isSignedIn() && isValidId(docId) && isValidPayload(incoming());
      allow delete: if isSignedIn() && isValidId(docId);
    }

    match /customer_segments/{docId} {
      allow get: if isSignedIn() && isValidId(docId);
      allow list: if isSignedIn();
      allow create, update: if isSignedIn() && isValidId(docId) && isValidPayload(incoming());
      allow delete: if isSignedIn() && isValidId(docId);
    }

    match /customer_bookings/{docId} {
      allow get: if isSignedIn() && isValidId(docId);
      allow list: if isSignedIn();
      allow create, update: if isSignedIn() && isValidId(docId) && isValidPayload(incoming());
      allow delete: if isSignedIn() && isValidId(docId);
    }

    match /proactive_customer_bookings/{docId} {
      allow get: if isSignedIn() && isValidId(docId);
      allow list: if isSignedIn();
      allow create, update: if isSignedIn() && isValidId(docId) && isValidPayload(incoming());
      allow delete: if isSignedIn() && isValidId(docId);
    }

    match /segment_customer_bookings/{docId} {
      allow get: if isSignedIn() && isValidId(docId);
      allow list: if isSignedIn();
      allow create, update: if isSignedIn() && isValidId(docId) && isValidPayload(incoming());
      allow delete: if isSignedIn() && isValidId(docId);
    }

    match /service_quality_reviews/{docId} {
      allow get: if isSignedIn() && isValidId(docId);
      allow list: if isSignedIn();
      allow create, update: if isSignedIn() && isValidId(docId) && isValidPayload(incoming());
      allow delete: if isSignedIn() && isValidId(docId);
    }

    match /service_quality_customer_bookings/{docId} {
      allow get: if isSignedIn() && isValidId(docId);
      allow list: if isSignedIn();
      allow create, update: if isSignedIn() && isValidId(docId) && isValidPayload(incoming());
      allow delete: if isSignedIn() && isValidId(docId);
    }

    match /crm_state_maps/{docId} {
      allow get: if isSignedIn() && isValidId(docId);
      allow list: if isSignedIn();
      allow create, update: if isSignedIn() && isValidId(docId) && isValidPayload(incoming());
      allow delete: if isSignedIn() && isValidId(docId);
    }

    match /discounts/{docId} {
      allow get: if isSignedIn() && isValidId(docId);
      allow list: if isSignedIn();
      allow create, update: if isSignedIn() && isValidId(docId) && isValidPayload(incoming());
      allow delete: if isSignedIn() && isValidId(docId);
    }

    match /referral_history/{docId} {
      allow get: if isSignedIn() && isValidId(docId);
      allow list: if isSignedIn();
      allow create, update: if isSignedIn() && isValidId(docId) && isValidPayload(incoming());
      allow delete: if isSignedIn() && isValidId(docId);
    }

    match /customers/{docId} {
      allow get: if isSignedIn() && isValidId(docId);
      allow list: if isSignedIn();
      allow create, update: if isSignedIn() && isValidId(docId) && isValidPayload(incoming());
      allow delete: if isSignedIn() && isValidId(docId);
    }

    match /booking_customer_profiles/{docId} {
      allow get: if isSignedIn() && isValidId(docId);
      allow list: if isSignedIn();
      allow create, update: if isSignedIn() && isValidId(docId) && isValidPayload(incoming());
      allow delete: if isSignedIn() && isValidId(docId);
    }

    match /events/{docId} {
      allow get: if isSignedIn() && isValidId(docId);
      allow list: if isSignedIn();
      allow create, update: if isSignedIn() && isValidId(docId) && isValidPayload(incoming());
      allow delete: if isSignedIn() && isValidId(docId);
    }

    match /registration_approvals/{docId} {
      allow get: if isSignedIn() && isValidId(docId);
      allow list: if isSignedIn();
      allow create, update: if isSignedIn() && isValidId(docId) && isValidPayload(incoming());
      allow delete: if isSignedIn() && isValidId(docId);
    }

    match /commercial_sales/{docId} {
      allow get: if isSignedIn() && isValidId(docId);
      allow list: if isSignedIn();
      allow create, update: if isSignedIn() && isValidId(docId) && isValidPayload(incoming());
      allow delete: if isSignedIn() && isValidId(docId);
    }

    match /purchase_orders/{docId} {
      allow get: if isSignedIn() && isValidId(docId);
      allow list: if isSignedIn();
      allow create, update: if isSignedIn() && isValidId(docId) && isValidPayload(incoming());
      allow delete: if isSignedIn() && isValidId(docId);
    }

    match /shopping_cart/{docId} {
      allow get: if isSignedIn() && isValidId(docId);
      allow list: if isSignedIn();
      allow create, update: if isSignedIn() && isValidId(docId) && isValidPayload(incoming());
      allow delete: if isSignedIn() && isValidId(docId);
    }

    match /online_orders/{docId} {
      allow get: if isSignedIn() && isValidId(docId);
      allow list: if isSignedIn();
      allow create, update: if isSignedIn() && isValidId(docId) && isValidPayload(incoming());
      allow delete: if isSignedIn() && isValidId(docId);
    }

    match /omnichannel_products/{docId} {
      allow get: if isSignedIn() && isValidId(docId);
      allow list: if isSignedIn();
      allow create, update: if isSignedIn() && isValidId(docId) && isValidPayload(incoming());
      allow delete: if isSignedIn() && isValidId(docId);
    }

    match /marketplace_products/{docId} {
      allow get: if isSignedIn() && isValidId(docId);
      allow list: if isSignedIn();
      allow create, update: if isSignedIn() && isValidId(docId) && isValidPayload(incoming());
      allow delete: if isSignedIn() && isValidId(docId);
    }

    match /repair_orders/{docId} {
      allow get: if isSignedIn() && isValidId(docId);
      allow list: if isSignedIn();
      allow create, update: if isSignedIn() && isValidId(docId) && isValidPayload(incoming());
      allow delete: if isSignedIn() && isValidId(docId);
    }

    match /employees/{docId} {
      allow get: if isSignedIn() && isValidId(docId);
      allow list: if isSignedIn();
      allow create, update: if isSignedIn() && isValidId(docId) && isValidPayload(incoming());
      allow delete: if isSignedIn() && isValidId(docId);
