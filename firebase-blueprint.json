{
  "entities": {
    "GenericRecord": {
      "title": "GenericRecord",
      "description": "Synchronized application entity record stored in Cloud Firestore",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Primary identifier of the record"
        },
        "_order": {
          "type": "number",
          "description": "Display order index"
        }
      }
    },
    "CrmStateMap": {
      "title": "CrmStateMap",
      "description": "State map payload for CRM history, tasks, activities, notes, and counts",
      "type": "object",
      "properties": {
        "payload": {
          "type": "object",
          "description": "Record map data"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Last update ISO timestamp"
        }
      },
      "required": ["payload", "updatedAt"]
    },
    "CategoryUnit": {
      "title": "CategoryUnit",
      "description": "Unit of measurement catalog item",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 128,
          "description": "Unique unit document identifier"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "description": "Unit of measurement name"
        },
        "_order": {
          "type": "number",
          "description": "Display order index"
        }
      },
      "required": ["id", "name"]
    },
    "CategoryBankAccount": {
      "title": "CategoryBankAccount",
      "description": "Company bank account catalog record",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 128,
          "description": "Unique bank account document identifier"
        },
        "bankCode": {
          "type": "string",
          "minLength": 1,
          "maxLength": 50,
          "description": "Short bank code"
        },
        "bankName": {
          "type": "string",
          "maxLength": 250,
          "description": "Full bank display name"
        },
        "accountNumber": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "description": "Unique bank account number"
        },
        "accountHolder": {
          "type": "string",
          "maxLength": 200,
          "description": "Account holder name"
        },
        "isReceiptAccount": {
          "type": "boolean",
          "description": "Whether account is used for receipts (TK thu)"
        },
        "isPaymentAccount": {
          "type": "boolean",
          "description": "Whether account is used for payments (TK chi)"
        },
        "isDefault": {
          "type": "boolean",
          "description": "Whether this is the default bank account"
        },
        "_order": {
          "type": "number",
          "description": "Display order index"
        }
      },
      "required": ["id", "bankCode", "bankName", "accountNumber", "accountHolder", "isReceiptAccount", "isPaymentAccount", "isDefault"]
    },
    "DocumentStorageCategory": {
      "title": "DocumentStorageCategory",
      "description": "Document storage classification group with nested document type definitions",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Unique document storage category identifier"
        },
        "groupName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "description": "Name of the document storage group"
        },
        "note": {
          "type": "string",
          "maxLength": 1000,
          "description": "Optional note for the document storage group"
        },
        "documentTypes": {
          "type": "array",
          "description": "Bounded list of document types belonging to the group (max 100 items)"
        },
        "_order": {
          "type": "number",
          "description": "Display order index"
        }
      },
      "required": ["id", "groupName", "note", "documentTypes"]
    },
    "DocumentCabinet": {
      "title": "DocumentCabinet",
      "description": "Stored document cabinet record with classification, validity dates, and attached file links",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Unique document cabinet record identifier"
        },
        "documentGroup": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "description": "Document group name"
        },
        "documentType": {
          "type": "string",
          "maxLength": 200,
          "description": "Document type name"
        },
        "storageType": {
          "type": "string",
          "maxLength": 100,
          "description": "Storage medium type (Bản Cứng / Bản Mềm / Bản Cứng/ bản Mềm)"
        },
        "location": {
          "type": "string",
          "maxLength": 200,
          "description": "Physical cabinet or shelf location"
        },
        "effectiveDate": {
          "type": "string",
          "maxLength": 32,
          "description": "Effective date string (DD/MM/YYYY)"
        },
        "expiryDate": {
          "type": "string",
          "maxLength": 32,
          "description": "Expiry date string (DD/MM/YYYY)"
        },
        "isValid": {
          "type": "boolean",
          "description": "Whether the document is still valid"
        },
        "files": {
          "type": "array",
          "description": "Bounded list of attached file descriptors and links (max 50 items)"
        },
        "createdAt": {
          "type": "string",
          "maxLength": 64,
          "description": "Formatted creation timestamp"
        },
        "updatedAt": {
          "type": "string",
          "maxLength": 64,
          "description": "Formatted last updated timestamp"
        },
        "_order": {
          "type": "number",
          "description": "Display order index"
        }
      },
      "required": ["id", "documentGroup", "documentType", "storageType", "location", "effectiveDate", "expiryDate", "isValid", "files", "createdAt", "updatedAt"]
    }
  },
