rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Default-Deny Catch-All for unmapped paths
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null && request.auth.uid is string && request.auth.uid.size() >= 1;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function isValidPayload(data) {
      return data is map && data.keys().size() >= 1 && data.keys().size() <= 200;
    }

    function isValidCategoryUnit(data) {
      return data is map
        && data.keys().hasAll(['id', 'name'])
        && data.keys().hasOnly(['id', 'name', '_order'])
        && data.id is string && data.id.size() >= 1 && data.id.size() <= 128
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 200
        && (!('_order' in data) || data._order is number);
    }

    function isValidCategoryBankAccount(data) {
      return data is map
        && data.keys().hasAll(['id', 'bankCode', 'bankName', 'accountNumber', 'accountHolder', 'isReceiptAccount', 'isPaymentAccount', 'isDefault'])
        && data.keys().hasOnly(['id', 'bankCode', 'bankName', 'accountNumber', 'accountHolder', 'isReceiptAccount', 'isPaymentAccount', 'isDefault', '_order'])
        && data.id is string && data.id.size() >= 1 && data.id.size() <= 128
        && data.bankCode is string && data.bankCode.size() >= 1 && data.bankCode.size() <= 50
        && data.bankName is string && data.bankName.size() <= 250
        && data.accountNumber is string && data.accountNumber.size() >= 1 && data.accountNumber.size() <= 64
        && data.accountHolder is string && data.accountHolder.size() <= 200
        && data.isReceiptAccount is bool
        && data.isPaymentAccount is bool
        && data.isDefault is bool
        && (!('_order' in data) || data._order is number);
    }

    match /test/{docId} {
      allow get: if isSignedIn() && isValidId(docId);
      allow list: if isSignedIn();
      allow create, update: if isSignedIn() && isValidId(docId) && isValidPayload(incoming());
      allow delete: if isSignedIn() && isValidId(docId);
    }

    match /potential_customers/{docId} {
      allow get: if isSignedIn() && isValidId(docId);
      allow list: if isSignedIn();
      allow create, update: if isSignedIn() && isValidId(docId) && isValidPayload(incoming());
      allow delete: if isSignedIn() && isValidId(docId);
    }

    match /proactive_reminders/{docId} {
      allow get: if isSignedIn() && isValidId(docId);
      allow list: if isSignedIn();
      allow create, update: if isSignedIn() && isValidId(docId) && isValidPayload(incoming());
      allow delete: if isSignedIn() && isValidId(docId);
    }

    match /customer_segments/{docId} {
      allow get: if isSignedIn() && isValidId(docId);
      allow list: if isSignedIn();
      allow create, update: if isSignedIn() && isValidId(docId) && isValidPayload(incoming());
      allow delete: if isSignedIn() && isValidId(docId);
    }

    match /customer_bookings/{docId} {
      allow get: if isSignedIn() && isValidId(docId);
      allow list: if isSignedIn();
      allow create, update: if isSignedIn() && isValidId(docId) && isValidPayload(incoming());
      allow delete: if isSignedIn() && isValidId(docId);
    }

    match /proactive_customer_bookings/{docId} {
      allow get: if isSignedIn() && isValidId(docId);
      allow list: if isSignedIn();
      allow create, update: if isSignedIn() && isValidId(docId) && isValidPayload(incoming());
      allow delete: if isSignedIn() && isValidId(docId);
    }

    match /segment_customer_bookings/{docId} {
      allow get: if isSignedIn() && isValidId(docId);
      allow list: if isSignedIn();
      allow create, update: if isSignedIn() && isValidId(docId) && isValidPayload(incoming());
      allow delete: if isSignedIn() && isValidId(docId);
    }

    match /service_quality_reviews/{docId} {
      allow get: if isSignedIn() && isValidId(docId);
      allow list: if isSignedIn();
      allow create, update: if isSignedIn() && isValidId(docId) && isValidPayload(incoming());
      allow delete: if isSignedIn() && isValidId(docId);
    }

    match /service_quality_customer_bookings/{docId} {
      allow get: if isSignedIn() && isValidId(docId);
      allow list: if isSignedIn();
      allow create, update: if isSignedIn() && isValidId(docId) && isValidPayload(incoming());
      allow delete: if isSignedIn() && isValidId(docId);
    }

    match /crm_state_maps/{docId} {
      allow get: if isSignedIn() && isValidId(docId);
      allow list: if isSignedIn();
      allow create, update: if isSignedIn() && isValidId(docId) && isValidPayload(incoming());
      allow delete: if isSignedIn() && isValidId(docId);
    }

    match /discounts/{docId} {
      allow get: if isSignedIn() && isValidId(docId);
      allow list: if isSignedIn();
      allow create, update: if isSignedIn() && isValidId(docId) && isValidPayload(incoming());
      allow delete: if isSignedIn() && isValidId(docId);
    }

    match /referral_history/{docId} {
      allow get: if isSignedIn() && isValidId(docId);
      allow list: if isSignedIn();
      allow create, update: if isSignedIn() && isValidId(docId) && isValidPayload(incoming());
      allow delete: if isSignedIn() && isValidId(docId);
    }

    match /customers/{docId} {
      allow get: if isSignedIn() && isValidId(docId);
      allow list: if isSignedIn();
      allow create, update: if isSignedIn() && isValidId(docId) && isValidPayload(incoming());
      allow delete: if isSignedIn() && isValidId(docId);
    }

    match /booking_customer_profiles/{docId} {
      allow get: if isSignedIn() && isValidId(docId);
      allow list: if isSignedIn();
      allow create, update: if isSignedIn() && isValidId(docId) && isValidPayload(incoming());
      allow delete: if isSignedIn() && isValidId(docId);
    }

    match /events/{docId} {
      allow get: if isSignedIn() && isValidId(docId);
      allow list: if isSignedIn();
      allow create, update: if isSignedIn() && isValidId(docId) && isValidPayload(incoming());
      allow delete: if isSignedIn() && isValidId(docId);
    }

    match /registration_approvals/{docId} {
      allow get: if isSignedIn() && isValidId(docId);
      allow list: if isSignedIn();
      allow create, update: if isSignedIn() && isValidId(docId) && isValidPayload(incoming());
      allow delete: if isSignedIn() && isValidId(docId);
    }

    match /commercial_sales/{docId} {
      allow get: if isSignedIn() && isValidId(docId);
