rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Default-Deny Catch-All for unmapped paths
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null && request.auth.uid is string && request.auth.uid.size() >= 1;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function isValidPayload(data) {
      return data is map && data.keys().size() >= 1 && data.keys().size() <= 200;
    }

    match /test/{docId} {
      allow get: if isSignedIn() && isValidId(docId);
      allow list: if isSignedIn();
      allow create, update: if isSignedIn() && isValidId(docId) && isValidPayload(incoming());
      allow delete: if isSignedIn() && isValidId(docId);
    }

    match /potential_customers/{docId} {
      allow get: if isSignedIn() && isValidId(docId);
      allow list: if isSignedIn();
      allow create, update: if isSignedIn() && isValidId(docId) && isValidPayload(incoming());
      allow delete: if isSignedIn() && isValidId(docId);
    }

    match /proactive_reminders/{docId} {
      allow get: if isSignedIn() && isValidId(docId);
      allow list: if isSignedIn();
      allow create, update: if isSignedIn() && isValidId(docId) && isValidPayload(incoming());
      allow delete: if isSignedIn() && isValidId(docId);
    }

    match /customer_segments/{docId} {
      allow get: if isSignedIn() && isValidId(docId);
      allow list: if isSignedIn();
      allow create, update: if isSignedIn() && isValidId(docId) && isValidPayload(incoming());
      allow delete: if isSignedIn() && isValidId(docId);
    }

    match /customer_bookings/{docId} {
      allow get: if isSignedIn() && isValidId(docId);
      allow list: if isSignedIn();
      allow create, update: if isSignedIn() && isValidId(docId) && isValidPayload(incoming());
      allow delete: if isSignedIn() && isValidId(docId);
    }

    match /proactive_customer_bookings/{docId} {
      allow get: if isSignedIn() && isValidId(docId);
      allow list: if isSignedIn();
      allow create, update: if isSignedIn() && isValidId(docId) && isValidPayload(incoming());
      allow delete: if isSignedIn() && isValidId(docId);
    }

    match /segment_customer_bookings/{docId} {
      allow get: if isSignedIn() && isValidId(docId);
